// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`public homepage and branding > serves a static homepage without published document information or JS 1`] = `
"<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="referrer" content="no-referrer">
<meta name="robots" content="noindex,nofollow,noarchive">
<meta name="description" content="Mote — publish local Markdown as immutable, browser-readable pages.">
<title>Mote — Markdown in, URL out.</title>
<link rel="icon" href="/favicon.ico" sizes="16x16 32x32">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<style>
:root {
  --mote-fg: #1f2328;
  --mote-bg: #ffffff;
  --mote-muted: #59636e;
  --mote-border: #d1d9e0;
  --mote-code-bg: #eff1f3;
  --mote-pre-bg: #f6f8fa;
  --mote-toc-bg: #f6f8fa;
  --mote-brand: #ef5552;
  --mote-accent: #c23c39;
  --mote-accent-strong: #a92f2c;
  --mote-on-accent: #ffffff;
  --mote-tint: #fef1f0;
  --mote-tint-border: #f3c8c5;
  --mote-glow-from: rgb(239 85 82 / 0.16);
  --mote-glow-to: rgb(239 85 82 / 0);
}

@media (prefers-color-scheme: dark) {
  :root {
    --mote-fg: #e6edf3;
    --mote-bg: #0d1117;
    --mote-muted: #9198a1;
    --mote-border: #3d444d;
    --mote-code-bg: #2f3742;
    --mote-pre-bg: #161b22;
    --mote-toc-bg: #161b22;
    --mote-brand: #ff6d6a;
    --mote-accent: #ff8582;
    --mote-accent-strong: #ff9d9a;
    --mote-on-accent: #2b0d0c;
    --mote-tint: #2b1617;
    --mote-tint-border: #5a2a29;
    --mote-glow-from: rgb(255 109 106 / 0.14);
    --mote-glow-to: rgb(255 109 106 / 0);
  }
}

body {
  margin: 0;
  background: var(--mote-bg);
  color: var(--mote-fg);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans",
    Helvetica, Arial, sans-serif;
  font-size: 16px;
  line-height: 1.6;
  word-wrap: break-word;
}

::selection {
  background: var(--mote-brand);
  color: var(--mote-on-accent);
}

a { color: var(--mote-accent); }
a:hover { color: var(--mote-accent-strong); }
a:focus-visible {
  outline: 2px solid var(--mote-accent);
  outline-offset: 3px;
  border-radius: 2px;
}

code, kbd, pre {
  font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas,
    "Liberation Mono", monospace;
}

.visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
code { background: var(--mote-code-bg); padding: 0.15em 0.35em; border-radius: 6px; font-size: 0.85em; }

.header-rule { border-bottom: 1px solid var(--mote-border); }
.home-header { max-width: 1152px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; padding: 26px 24px; }
.home-header svg { display: block; width: 148px; height: auto; }
@media (prefers-color-scheme: dark) { .home-header [data-wordmark] { fill: #e6edf3; } }
.home-header nav { display: flex; gap: 28px; font-size: 15px; }
.home-header nav a, .home-footer a { color: var(--mote-fg); text-decoration: none; }
.home-header nav a:hover, .home-footer a:hover { color: var(--mote-accent); text-decoration: none; }

.hero-wrap {
  background:
    radial-gradient(760px 360px at 15% -80px, var(--mote-glow-from), var(--mote-glow-to)),
    radial-gradient(620px 320px at 85% -40px, var(--mote-glow-from), var(--mote-glow-to)),
    radial-gradient(var(--mote-tint-border) 1px, transparent 1.5px);
  background-size: auto, auto, 24px 24px;
  -webkit-mask-image: linear-gradient(to bottom, #000 55%, transparent);
  mask-image: linear-gradient(to bottom, #000 55%, transparent);
}
.hero { max-width: 1152px; margin: 0 auto; padding: 88px 24px 104px; display: grid; grid-template-columns: 1.05fr 0.95fr; gap: 56px; align-items: center; }
.hero h1 { font-size: clamp(46px, 6.2vw, 88px); line-height: 1.02; letter-spacing: -0.03em; font-weight: 750; margin: 0 0 24px; }
.hero h1 span { color: var(--mote-brand); }
.hero-sub { font-size: 20px; color: var(--mote-muted); margin: 0 0 34px; max-width: 38ch; }
.hero-actions { display: flex; flex-wrap: wrap; gap: 14px; }
.button { display: inline-block; padding: 12px 24px; border-radius: 10px; font-size: 16px; font-weight: 600; text-decoration: none; }
.button-primary { background: var(--mote-accent); color: var(--mote-on-accent); }
.button-primary:hover { background: var(--mote-accent-strong); color: var(--mote-on-accent); text-decoration: none; }
.button-secondary { background: var(--mote-bg); border: 1px solid var(--mote-border); color: var(--mote-fg); }
.button-secondary:hover { border-color: var(--mote-accent); color: var(--mote-accent); text-decoration: none; }

.terminal { background: #1c2128; border: 1px solid rgb(255 255 255 / 0.09); border-radius: 14px; box-shadow: 0 32px 64px -32px rgb(239 85 82 / 0.35), 0 12px 28px rgb(15 17 21 / 0.18); overflow: hidden; font-size: 15px; }
.terminal-bar { display: flex; gap: 7px; padding: 14px 16px; border-bottom: 1px solid rgb(255 255 255 / 0.07); }
.terminal-dot { width: 11px; height: 11px; border-radius: 50%; background: #3d444d; }
.terminal-dot:first-child { background: var(--mote-brand); }
.terminal pre { margin: 0; padding: 20px 22px 24px; overflow-x: auto; color: #e6edf3; line-height: 1.75; }
.terminal pre code { background: transparent; padding: 0; font-size: inherit; }
.terminal-prompt { color: #ff8582; font-weight: 600; }
.terminal a { color: #ff8582; text-decoration: underline; text-underline-offset: 3px; }
.terminal a:hover { color: #ffb3b1; }
@media (prefers-color-scheme: dark) { .terminal { border-color: rgb(255 255 255 / 0.12); box-shadow: 0 32px 64px -32px rgb(255 109 106 / 0.22), 0 12px 28px rgb(0 0 0 / 0.5); } }

.section { max-width: 1152px; margin: 0 auto; padding: 72px 24px; }
.section-title { font-size: 13px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--mote-accent); margin: 0 0 32px; padding: 0; border: 0; }

.steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
.steps li { border: 1px solid var(--mote-border); border-radius: 14px; padding: 24px; }
.step-number { display: inline-flex; align-items: center; justify-content: center; width: 34px; height: 34px; margin-bottom: 16px; border-radius: 50%; background: var(--mote-tint); border: 1px solid var(--mote-tint-border); color: var(--mote-accent); font-size: 15px; font-weight: 700; }
.steps h3 { margin: 0 0 8px; font-size: 19px; letter-spacing: -0.01em; }
.steps p { margin: 0; color: var(--mote-muted); font-size: 15px; }

.feature-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
.feature { border: 1px solid var(--mote-border); border-radius: 14px; padding: 24px; }
.feature h3 { margin: 0 0 8px; font-size: 17px; }
.feature h3::before { content: ''; display: block; width: 22px; height: 3px; margin-bottom: 14px; border-radius: 2px; background: var(--mote-brand); }
.feature p { margin: 0; color: var(--mote-muted); font-size: 15px; }

.quickstart { scroll-margin-top: 24px; }
.quickstart-title { font-size: clamp(28px, 4vw, 40px); letter-spacing: -0.03em; margin: 0 0 26px; padding: 0; border: 0; }
.publish-methods { border: 0; margin: 0; padding: 0; min-width: 0; display: flex; flex-wrap: wrap; gap: 10px; }
.method-label { padding: 9px 20px; border-radius: 999px; border: 1px solid var(--mote-border); font-size: 15px; font-weight: 600; color: var(--mote-muted); cursor: pointer; }
.method-label:hover { color: var(--mote-fg); border-color: var(--mote-muted); background: var(--mote-pre-bg); }
.method-choice:checked + .method-label { color: var(--mote-accent); border-color: var(--mote-tint-border); background: var(--mote-tint); }
.method-choice:focus-visible + .method-label { outline: 2px solid var(--mote-accent); outline-offset: 2px; }
.publish-option { display: none; width: 100%; min-width: 0; padding-top: 18px; }
#method-cli:checked ~ #panel-cli, #method-mcp:checked ~ #panel-mcp, #method-skill:checked ~ #panel-skill { display: block; }
.publish-option .option-summary { font-size: 17px; margin: 0 0 16px; }
.publish-option p:last-child { margin-bottom: 0; }
.quickstart pre { border: 1px solid var(--mote-border); background: var(--mote-pre-bg); border-radius: 12px; padding: 18px 20px; font-size: 15px; line-height: 1.7; overflow-x: auto; margin: 0 0 14px; }
.quickstart pre code { background: transparent; padding: 0; font-size: inherit; }
.quickstart p { color: var(--mote-muted); font-size: 15px; }
.quickstart p a, .steps a { text-decoration: underline; text-underline-offset: 3px; }
@media print {
  .publish-option { display: block; }
  .method-label { display: none; }
}

.footer-wrap { border-top: 1px solid var(--mote-border); }
.home-footer { max-width: 1152px; margin: 0 auto; padding: 48px 24px 56px; display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 32px; }
.footer-mark { display: inline-block; width: 12px; height: 12px; border-radius: 4px; background: var(--mote-brand); }
.footer-brand p { color: var(--mote-muted); font-size: 14px; margin: 12px 0 0; }
.footer-heading { display: block; font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--mote-muted); margin-bottom: 14px; }
.home-footer nav { display: flex; flex-direction: column; gap: 10px; font-size: 14px; }

@media (max-width: 900px) {
  .hero { grid-template-columns: 1fr; gap: 44px; padding: 56px 24px 72px; }
  .steps, .feature-grid { grid-template-columns: 1fr 1fr; }
  .home-footer { grid-template-columns: 1fr 1fr; }
}
@media (max-width: 640px) {
  .home-header { padding: 20px 24px; }
  .home-header svg { width: 120px; }
  .hero-sub { font-size: 18px; }
  .section { padding: 48px 24px; }
  .steps, .feature-grid, .home-footer { grid-template-columns: 1fr; }
}
</style>
</head>
<body>
<div class="header-rule"><header class="home-header">
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1204 304" role="img" aria-label="Mote">
  <g fill="#ef5552" transform="translate(-394 -225)">
    <path fill-rule="evenodd" d="M415 361Q415 348 426 337L508 257Q517 248 530 248H594Q610 248 621 259L704 339Q714 349 714 363V483Q714 504 693 504H652V424C652 382 590 382 590 424V504H547V424C547 382 484 382 484 424V504H437Q415 504 415 482ZM438 351H495Q524 351 524 322V267Z"/>
    <rect x="702" y="245" width="64" height="65" rx="12"/>
    <g fill="#20252b" data-wordmark="true">
    <path d="M828 335H870V351C896 322 941 326 967 354C997 322 1042 326 1066 350Q1082 368 1082 395V504H1039V404C1039 360 977 360 977 404V504H934V404C934 360 870 360 870 404V504H828Z"/>
    <path fill-rule="evenodd" d="M1187 331C1240 331 1279 369 1279 420C1279 471 1240 508 1187 508C1134 508 1095 471 1095 420C1095 369 1134 331 1187 331ZM1187 371C1159 371 1138 391 1138 420C1138 449 1159 469 1187 469C1215 469 1236 449 1236 420C1236 391 1215 371 1187 371Z"/>
    <path d="M1309 278H1353V333H1391V367H1353V444Q1353 467 1376 467H1397V502Q1383 505 1370 505Q1309 505 1309 447V367H1281V333H1309Z"/>
    <path fill-rule="evenodd" d="M1578 437H1442C1448 459 1464 471 1488 471Q1513 471 1528 454H1572C1558 489 1528 508 1488 508C1435 508 1399 471 1399 420C1399 369 1436 331 1489 331C1544 331 1578 369 1578 420ZM1444 404H1535C1529 382 1513 369 1489 369C1467 369 1450 382 1444 404Z"/>
    </g>
  </g>
</svg>

<nav aria-label="Project"><a href="https://github.com/flc1125/mote/blob/main/docs/cli.md">Docs</a><a href="https://github.com/flc1125/mote">GitHub</a></nav>
</header></div>
<div class="hero-wrap"><main>
<section class="hero" aria-labelledby="intro">
<div>
<h1 id="intro">Markdown in.<br><span>URL out.</span></h1>
<p class="hero-sub">Publish local Markdown as immutable, browser-readable pages. No database, no JavaScript — just a link that works forever.</p>
<p class="hero-actions"><a class="button button-primary" href="#quickstart">Get started</a><a class="button button-secondary" href="https://github.com/flc1125/mote#readme">Read the docs</a></p>
</div>
<div class="terminal">
<div class="terminal-bar" aria-hidden="true"><span class="terminal-dot"></span><span class="terminal-dot"></span><span class="terminal-dot"></span></div>
<pre tabindex="0" role="region" aria-label="Publishing a document with the Mote CLI"><code><span class="terminal-prompt">$</span> mote README.md

Published:
<a href="https://mote.flc.io/1tAPUJjNt67GQ2pS">https://mote.flc.io/1tAPUJjNt67GQ2pS</a></code></pre>
</div>
</section>
</main></div>
<section class="section" aria-labelledby="how-title">
<h2 class="section-title" id="how-title">How it works</h2>
<ol class="steps">
<li><span class="step-number" aria-hidden="true">1</span><h3>Write</h3><p>Keep Markdown as the single source of truth, with images next to the file.</p></li>
<li><span class="step-number" aria-hidden="true">2</span><h3>Publish</h3><p><code>mote README.md</code> uploads the document and every referenced image.</p></li>
<li><span class="step-number" aria-hidden="true">3</span><h3>Share</h3><p>The URL is the credential — anyone with the unguessable link can read.</p></li>
</ol>
</section>
<section class="section" aria-labelledby="features-title">
<h2 class="section-title" id="features-title">Why Mote</h2>
<div class="feature-grid">
<div class="feature"><h3>Immutable</h3><p>Every publish creates a new URL; old links keep their content forever.</p></div>
<div class="feature"><h3>Capability URLs</h3><p>94-bit unguessable IDs. No accounts, no ACLs — the link is the access.</p></div>
<div class="feature"><h3>Local images</h3><p>Referenced images upload automatically, deduplicated, served from opaque URLs.</p></div>
<div class="feature"><h3>Fast at the edge</h3><p>Cloudflare Workers + R2 + CDN cache. No database to slow anything down.</p></div>
<div class="feature"><h3>No JavaScript</h3><p>Pages are pure HTML and CSS under a maximally strict CSP.</p></div>
<div class="feature"><h3>Agent-ready</h3><p>CLI <code>--json</code> output, remote and local MCP servers, and an agent Skill.</p></div>
</div>
</section>
<section class="section quickstart" id="quickstart" aria-labelledby="quickstart-title">
<h2 class="section-title" id="quickstart-title">Quick start</h2>
<p class="quickstart-title">From file to link.</p>
<fieldset class="publish-methods">
<legend class="visually-hidden">Choose a publishing method</legend>
<input class="method-choice visually-hidden" type="radio" name="publish-method" id="method-cli" aria-controls="panel-cli" checked>
<label class="method-label" for="method-cli">CLI</label>
<input class="method-choice visually-hidden" type="radio" name="publish-method" id="method-mcp" aria-controls="panel-mcp">
<label class="method-label" for="method-mcp">MCP</label>
<input class="method-choice visually-hidden" type="radio" name="publish-method" id="method-skill" aria-controls="panel-skill">
<label class="method-label" for="method-skill">Skill</label>
<section class="publish-option" id="panel-cli" aria-label="CLI instructions">
<p class="option-summary">Publish from your terminal.</p>
<pre tabindex="0" role="region" aria-label="CLI quick start commands"><code>npm install -g mote-cli
mote login
mote README.md</code></pre>
<p>Log in to your Access-enabled Mote instance. Your instance is remembered for future publishes. For other authentication modes, see the <a href="https://github.com/flc1125/mote/blob/main/docs/authentication.md">authentication guide</a>.</p>
</section>
<section class="publish-option" id="panel-mcp" aria-label="MCP instructions">
<p class="option-summary">Connect your AI assistant. For example, with Codex:</p>
<pre tabindex="0" role="region" aria-label="Codex MCP setup commands"><code>codex mcp add mote --url https://mote.flc.io/api/mcp
codex mcp login mote</code></pre>
<p>Use your own instance URL. Before connecting, complete the instance-specific OAuth client and callback configuration in the <a href="https://github.com/flc1125/mote/blob/main/docs/mcp.md">MCP setup guide</a>. Then ask your assistant to publish Markdown.</p>
</section>
<section class="publish-option" id="panel-skill" aria-label="Skill instructions">
<p class="option-summary">Teach your agent when and how to publish.</p>
<pre tabindex="0" role="region" aria-label="Skill installation command"><code>npx skills add flc1125/mote --skill mote</code></pre>
<p>Choose your agent during installation. The skill uses your configured CLI or MCP tools; set up one of them first. See the <a href="https://github.com/flc1125/mote/blob/main/docs/skill.md">Skill guide</a>.</p>
</section>
</fieldset>
</section>
<div class="footer-wrap"><footer class="home-footer">
<div class="footer-brand"><span class="footer-mark" aria-hidden="true"></span><p>Markdown in, URL out.</p></div>
<div><span class="footer-heading">Docs</span><nav aria-label="Documentation">
<a href="https://github.com/flc1125/mote/blob/main/docs/self-hosting.md">Self-hosting</a>
<a href="https://github.com/flc1125/mote/blob/main/docs/architecture.md">Architecture</a>
<a href="https://github.com/flc1125/mote/blob/main/docs/protocol.md">Protocol</a>
<a href="https://github.com/flc1125/mote/blob/main/docs/security.md">Security</a>
</nav></div>
<div><span class="footer-heading">Publish</span><nav aria-label="Publishing tools">
<a href="https://github.com/flc1125/mote/blob/main/docs/cli.md">CLI</a>
<a href="https://github.com/flc1125/mote/blob/main/docs/mcp.md">MCP</a>
<a href="https://github.com/flc1125/mote/blob/main/docs/skill.md">Skill</a>
</nav></div>
<div><span class="footer-heading">Project</span><nav aria-label="Project links">
<a href="https://github.com/flc1125/mote">GitHub</a>
<a href="https://github.com/flc1125/mote/blob/main/LICENSE">MIT License</a>
</nav></div>
</footer></div>
</body>
</html>
"
`;
