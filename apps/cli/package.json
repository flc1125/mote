{
  "name": "@mote/cli",
  "version": "0.1.1",
  "private": false,
  "type": "module",
  "description": "Mote = Markdown in, URL out. Publish Markdown as immutable, unguessable web pages.",
  "keywords": [
    "markdown",
    "publish",
    "cli",
    "cloudflare-workers",
    "mcp",
    "immutable",
    "static"
  ],
  "license": "MIT",
  "author": "flc1125",
  "homepage": "https://github.com/flc1125/mote#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flc1125/mote.git",
    "directory": "apps/cli"
  },
  "bugs": "https://github.com/flc1125/mote/issues",
  "engines": {
    "node": ">=20"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "mote": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "preferGlobal": true,
  "publishConfig": {
    "name": "mote-cli",
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:package": "node scripts/test-package.mjs",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@mote/core": "workspace:*",
    "@mote/protocol": "workspace:*",
    "esbuild": "^0.25.0",
    "markdown-it": "^15.0.1",
    "miniflare": "^4.0.0",
    "oauth4webapi": "3.8.7"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "2.0.0"
  }
}
