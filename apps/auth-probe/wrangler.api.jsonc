{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Local regression fixture only. The fake account prevents cloud deployment.
  "name": "mote-local-probe-api",
  "account_id": "00000000000000000000000000000000",
  "main": "src/api.ts",
  // Match Mote's existing workerd test baseline; this is a Phase 0 adapter.
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "vars": {
    "VIEWER_BASE_URL": "https://mote-probe.example.invalid",
    "ACCESS_ISSUER": "https://access.example.invalid",
    "ACCESS_AUD": "local-probe-audience",
  },
  "r2_buckets": [
    { "binding": "DOCUMENTS", "bucket_name": "mote-local-probe-documents", "remote": false },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "logs": { "invocation_logs": false },
  },
}
