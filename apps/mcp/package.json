{
  "name": "@mote/mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "mote-mcp": "./dist/mcp.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "esbuild src/mcp.ts --bundle --platform=node --format=esm --target=node20 --external:@napi-rs/keyring --outfile=dist/mcp.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@mote/cli": "workspace:*",
    "@mote/core": "workspace:*",
    "@mote/protocol": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.5.4"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "2.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "miniflare": "^4.0.0"
  }
}
